datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String        @id @default(uuid())
  email         String        @unique
  phone         String?       @unique
  emailVerified Boolean       @default(false) @map("email_verified")
  phoneVerified Boolean       @default(false) @map("phone_verified")
  passwordHash  String        @map("password_hash")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  lastLoginAt   DateTime?     @map("last_login_at")
  accountStatus AccountStatus @default(ACTIVE) @map("account_status")

  sessions            Session[]
  trustedDevices      TrustedDevice[]
  verificationTokens  VerificationToken[]
  passwordResetTokens PasswordResetToken[]

  vault Vault?

  @@map("users")
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

model Session {
  id               String    @id @default(uuid())
  userId           String    @map("user_id")
  deviceId         String    @map("device_id")
  refreshTokenHash String    @map("refresh_token_hash")
  expiresAt        DateTime  @map("expires_at")
  lastActivityAt   DateTime  @default(now()) @map("last_activity_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  revokedAt        DateTime? @map("revoked_at")
  isActive         Boolean   @default(true) @map("is_active")

  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  device TrustedDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model TrustedDevice {
  id               String    @id @default(uuid())
  userId           String    @map("user_id")
  deviceName       String    @map("device_name")
  deviceIdentifier String    @map("device_identifier")
  platform         String
  browser          String
  lastIp           String?   @map("last_ip")
  lastSeenAt       DateTime? @map("last_seen_at")
  trustedSince     DateTime  @default(now()) @map("trusted_since")
  isActive         Boolean   @default(true) @map("is_active")
  createdAt        DateTime  @default(now()) @map("created_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions Session[]

  @@map("trusted_devices")
}

model VerificationToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash")
  tokenType TokenType @map("token_type")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("verification_tokens")
}

enum TokenType {
  EMAIL
  PHONE
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model Vault {
  id             String   @id @default(uuid())
  userId         String   @unique @map("user_id")
  encryptedVault String   @map("encrypted_vault")
  vaultSalt      String   @map("vault_salt")
  vaultVersion   Int      @default(1) @map("vault_version")
  lastModified   DateTime @default(now()) @map("last_modified")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("vaults")
}
