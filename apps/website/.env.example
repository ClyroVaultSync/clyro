# Clyro website — build-time configuration.
#
# Every value below has a committed fallback in src/lib/site-config.ts, so the
# site builds and runs without this file. Copy it to `.env.local` to override.
# NEXT_PUBLIC_* values are inlined into the client bundle at build time and are
# therefore public — never put a secret here.

# Canonical origin. Used for metadataBase, sitemap.xml and robots.txt.
# The live site is on Cloudflare Pages. Any change here must also be made to
# `externally_connectable` in apps/extension/manifest.json, or the extension
# bridge will refuse to talk to the deployed site.
NEXT_PUBLIC_SITE_URL=https://clyrovault.pages.dev

# Stable Chrome extension ID, derived from the public `key` committed to
# apps/extension/manifest.json. The bridge in src/lib/extension-bridge.ts sends
# messages to exactly this ID. Do not regenerate it — see docs/EXTENSION_HANDOFF.md.
NEXT_PUBLIC_CLYRO_EXTENSION_ID=cdaicnajdmjjdmghjblobeegdbdniiif

# Chrome Web Store listing. Placeholder until the extension is published.
NEXT_PUBLIC_CHROME_WEBSTORE_URL=https://chromewebstore.google.com/

# Local Sync Server download. Leave empty until a release exists — the setup
# page renders a disabled "coming soon" control rather than a dead link.
NEXT_PUBLIC_LOCAL_SERVER_DOWNLOAD_URL=

# Public repository. Drives the GitHub, Contributing and issue links site-wide.
NEXT_PUBLIC_CLYRO_GITHUB_URL=https://github.com/ClyroVaultSync/clyro
